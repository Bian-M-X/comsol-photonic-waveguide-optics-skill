{
  "schema_version": "1.0",
  "conventions": {
    "wavelength_unit": "nm",
    "sparameter_normalization": "power-wave",
    "time_dependence": "exp(+iwt)"
  },
  "components": {
    "waveguide": {
      "ports": ["o1", "o2"],
      "port_modes": {"o1": "TE0", "o2": "TE0"},
      "model_level": "reduced",
      "reference_plane": "component boundary",
      "sparameters": "../components/sparameters/waveguide.csv",
      "passive": true
    }
  },
  "instances": {
    "wg_left": {"component": "waveguide"},
    "wg_right": {"component": "waveguide"}
  },
  "connections": [["wg_left:o2", "wg_right:o1"]],
  "external_ports": {
    "in": "wg_left:o1",
    "out": "wg_right:o2"
  }
}
